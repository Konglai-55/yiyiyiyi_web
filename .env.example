# Wrangler: .dev.vars. Node/DreamPanel: deployment environment or ignored .env.production.
# All variables below are server-only; never prefix with NEXT_PUBLIC_ or VITE_.
S3_ENDPOINT=https://cn-nb1.rains3.com
S3_BUCKET=yiyiyiyi
S3_REGION=us-east-1
S3_PUBLIC_URL=https://yiyiyiyi.cn-nb1.rains3.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# The existing bucket's PRIVATE prefix; never use website/ for article records or drafts.
NEWS_STORAGE_PREFIX=cms-private/news-v1
# Required for Node; a writable persistent volume OUTSIDE versioned deployment releases.
ADMIN_DATA_DIR=/var/lib/yixiao-admin
APP_ORIGIN=https://yiyiyiyi.xn--fiqs8s
# Enable only if nginx overwrites X-Real-IP and external clients cannot bypass nginx.
TRUST_PROXY=0
